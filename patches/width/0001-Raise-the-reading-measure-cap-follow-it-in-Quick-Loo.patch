+/// The one place the reading-measure bounds live, shared by the renderer,
+/// reader profiles, and Settings.
+public enum ReadingMeasure {
+    /// Narrowest measure the renderer sets, in characters.
+    public static let minimumCharacters: CGFloat = 68
+    /// Wider than any window, so a measure this large fills the window: the
+    /// column is `min(preferred + bleed, available)`.  Finite only so the
+    /// container geometry and the Settings stepper stay well defined.
+    public static let maximumCharacters: CGFloat = 1000
+
+    public static func clamped(_ characters: CGFloat) -> CGFloat {
+        min(maximumCharacters, max(minimumCharacters, characters))
+    }
+}
