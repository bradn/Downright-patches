diff --git a/Sources/MarkdownRender/Theme/StyleSheet.swift b/Sources/MarkdownRender/Theme/StyleSheet.swift
index d5cfed9..70a2984 100644
--- a/Sources/MarkdownRender/Theme/StyleSheet.swift
+++ b/Sources/MarkdownRender/Theme/StyleSheet.swift
@@ -167,6 +167,9 @@ public struct StyleSheet {
         lineHeight = grid * 4
         let advance = StyleSheet.averageCharacterWidth(of: bodyFont)
         averageCharacterWidth = advance
+        // Upstream: `min(72, max(68, …))`.  The width patch keeps the 68 floor
+        // and lifts the ceiling to `ReadingMeasure.maximumCharacters`; the
+        // window, not the stylesheet, now limits a wide column.
         measureWidth = advance * ReadingMeasure.clamped(typography.measureCharacters)
         mathPointSize = StyleSheet.mathPointSize(body: bodyFont, typography: typography)
 
diff --git a/Sources/MarkdownRender/View/MarkdownContainerView.swift b/Sources/MarkdownRender/View/MarkdownContainerView.swift
index 6ea5a56..9d9f3b9 100644
--- a/Sources/MarkdownRender/View/MarkdownContainerView.swift
+++ b/Sources/MarkdownRender/View/MarkdownContainerView.swift
@@ -198,9 +198,13 @@ public final class MarkdownContainerView: NSView {
         // Keep the same measure across Document and Source. Widening source to
         // 90ch recenters the column and slides the left gutter rail, which
         // reads as the leading chrome teleporting on every mode switch.
-        // The setting wins at every window width; `available` below is what
-        // limits a wide measure.  A narrow window still tightens a classic
-        // 68–72 measure to 66.
+        // Local width patch.  Upstream clamped the setting to 68–72 here and
+        // then overrode it with the window: 66 below 900pt, 72 above 1200pt.
+        // So above 1200pt the user's choice was ignored, and nothing wider
+        // than 72 characters was reachable at all.  Now the setting wins at
+        // every window width; `available` below is what limits a wide
+        // measure.  A narrow window still tightens a classic 68–72 measure
+        // to 66, as upstream did.
         let renderedTarget = ReadingMeasure.clamped(
             textView.styleSheet.theme.typography.measureCharacters
         )
diff --git a/Sources/MarkdownRender/View/MarkdownTextView+Interaction.swift b/Sources/MarkdownRender/View/MarkdownTextView+Interaction.swift
