@@ -503,8 +503,11 @@ extension MarkdownTextView {
         // Sample inside the measure: the ornament itself lives in the hanging
         // indent, where there are no glyphs to hit-test against.
         let columnLeft = textContainerOrigin.x
-        // The live column, not the preferred measure: a wide measure setting
-        // is limited by the window.
+        // The live column, not the preferred measure.  Upstream clamped the
+        // sample point to `styleSheet.measureWidth`, which matched the column
+        // while the measure was capped at 72.  With a wide measure (width
+        // patch) the measure can be far wider than the window, so that clamp
+        // could put the sample point past the column's right edge.
         let liveMeasure = (textContainer?.size.width).map { $0 - RenderMetrics.codeBleed }
             ?? styleSheet.measureWidth
         let measure = max(2, min(styleSheet.measureWidth, liveMeasure))
