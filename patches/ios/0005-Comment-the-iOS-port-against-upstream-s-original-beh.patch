+    /// rendering of them stays byte-for-byte the same.
     case remoteImage(source: String, alt: String)
     /// A recognized but deliberately non-rendered tag, such as an image with
     /// an unsupported source.  Its source remains visible and no network or
@@ -364,6 +366,13 @@ public enum SafeHTMLParser {
     /// reader has no use for them, so they are dropped instead of rejecting
     /// the whole block.  Anything else unknown, and every `on…` handler, still
     /// rejects it.
+    ///
+    /// Upstream rejected a block on *any* attribute outside the small allowed
+    /// set, and on any unquoted value.  Downright's own README opens with
+    /// `<img … width="128">`, so its header block fell back to raw source on
+    /// both platforms.  This change applies on the Mac too: it is a parser
+    /// change, and it only turns source text into the same native rendering
+    /// an attribute-free block already got.
     private static let ignoredAttributes: Set<String> = [
         "width", "height", "align", "valign", "border", "hspace", "vspace",
         "class", "id", "style", "dir", "lang", "target", "rel",
diff --git a/Sources/MarkdownRender/Engine/DecorationEngine.swift b/Sources/MarkdownRender/Engine/DecorationEngine.swift
