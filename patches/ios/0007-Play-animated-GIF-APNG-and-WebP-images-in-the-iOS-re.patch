         let point = columnOrigin(point)
         guard isFirstParagraphOfBlock, let style = styleSheet else { return }
         let picture = displaySize()
@@ -78,7 +79,22 @@ final class ImageFragment: DownrightFragment {
             cg.fillRect(rect, color: matte(for: image, style: style),
                         radius: RenderMetrics.imageCornerRadius)
             cg.restoreGState()
+            #if os(iOS)
+            // A context can't animate, so an animated picture is shown by a
+            // live view the reader places over this rect; drawing the still
+            // under it as well would show through transparent frames.
+            if let animation = image.animatedSource, !AnimatedImageView.reduceMotion(),
+               let reader = context?.readerView {
+                let frame = super.layoutFragmentFrame
+                let inContainer = rect.offsetBy(dx: frame.minX - rawPoint.x, dy: frame.minY - rawPoint.y)
+                reader.showAnimation(image, animation: animation, key: payload.sourceRange.location,
+                                     containerRect: inContainer, cornerRadius: RenderMetrics.imageCornerRadius)
+            } else {
+                draw(image: image, in: rect, in: cg, cornerRadius: RenderMetrics.imageCornerRadius)
+            }
+            #else
             draw(image: image, in: rect, in: cg, cornerRadius: RenderMetrics.imageCornerRadius)
+            #endif
             if style.theme.appearance == .dark {
                 cg.setStrokeColor(style.text.withAlphaComponent(0.08).cgColor)
                 cg.setLineWidth(1)
