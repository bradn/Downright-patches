@@ -311,6 +311,12 @@ final class ImageRenderCache {
         if let declared = properties?[kCGImagePropertyHasAlpha] as? Bool {
             image.representations.first?.hasAlpha = declared
         }
+        #else
+        // A multi-frame image (GIF, animated PNG or WebP) stays this still
+        // frame for every path that draws stills; the iOS reader plays it
+        // from the attached source (UIKitView/AnimatedImage.swift).  The Mac
+        // keeps upstream's still frame.
+        image.animatedSource = AnimatedImageSource(url: url)
         #endif
         return image
     }
