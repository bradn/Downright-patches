diff --git a/Sources/MarkdownRender/Fragments/BoundedImageCache.swift b/Sources/MarkdownRender/Fragments/BoundedImageCache.swift
index 763f409..9f69c99 100644
--- a/Sources/MarkdownRender/Fragments/BoundedImageCache.swift
